{
	"name": "webdrop",
	"version": "0.1.0",
	"description": "Drop and share your HTML.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.15.0",
	"scripts": {
		"prebuild": "mkdir -p .wrangler",
		"build": "WRANGLER_LOG_PATH=.wrangler/wrangler-build.log vite build",
		"ci": "pnpm run --sequential \"/^ci:(check|test|deploy)$/\"",
		"ci:check": "pnpm run check",
		"ci:test": "pnpm test",
		"ci:deploy": "pnpm run check:acceptance",
		"precheck": "biome check .",
		"check": "pnpm run typecheck",
		"auth:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
		"auth:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote",
		"check:acceptance": "pnpm run --sequential \"/^check:acceptance:(manual|cli|preview)$/\"",
		"check:acceptance:manual": "BETTER_AUTH_SECRET=test-secret-that-is-at-least-32-characters GOOGLE_CLIENT_ID=test-google-client-id GOOGLE_CLIENT_SECRET=test-google-client-secret node deploy/cloudflare/deploy.ts --manifest test/fixtures/deploy/google.yaml --dry-run",
		"check:acceptance:cli": "node packages/webdrop/scripts/check-package.ts",
		"check:acceptance:preview": "pnpm run build && node test/preview.ts",
		"deploy": "node deploy/cloudflare/deploy.ts",
		"dev": "vite dev",
		"format": "biome format --write .",
		"pregenerate:types": "mkdir -p .wrangler types/generated",
		"generate:types": "WRANGLER_LOG_PATH=.wrangler/wrangler-types.log TMPDIR=.wrangler wrangler types types/generated/worker-configuration.d.ts",
		"prepublishOnly": "node --eval \"throw new Error('Webdrop is not published through npm.')\"",
		"preview": "node scripts/preview.ts",
		"pretest": "pnpm run build",
		"test": "WRANGLER_LOG_PATH=.wrangler/wrangler-test.log TMPDIR=.wrangler vitest run",
		"pretypecheck": "pnpm run generate:types",
		"typecheck": "pnpm run --sequential \"/^typecheck:(worker|test|browser|vite|deploy|cli)$/\"",
		"typecheck:worker": "tsc --project tsconfig.json --noEmit",
		"typecheck:test": "tsc --project test/tsconfig.json --noEmit",
		"typecheck:browser": "tsc --project tsconfig.browser.json --noEmit",
		"typecheck:vite": "tsc --project tsconfig.vite.json --noEmit",
		"typecheck:deploy": "tsc --project deploy/tsconfig.json --noEmit",
		"typecheck:cli": "tsc --project packages/webdrop/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@cloudflare/vite-plugin": "1.50.0",
		"@cloudflare/vitest-plugin": "^1.1.4",
		"@cloudflare/workers-types": "5.20260801.1",
		"@msw/cloudflare": "^0.0.1",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.1.1",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"ci-info": "4.4.0",
		"daisyui": "5.7.4",
		"jose": "6.1.2",
		"msw": "^2.15.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.0",
		"vitest": "4.1.10",
		"wrangler": "4.118.0",
		"yaml": "2.8.1"
	},
	"dependencies": {
		"better-auth": "1.7.3"
	}
}
