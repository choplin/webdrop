{
	"name": "@choplin/webdrop",
	"version": "0.1.0",
	"description": "Deploy Webdrop to your Cloudflare account.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/choplin/webdrop.git",
		"directory": "packages/webdrop"
	},
	"homepage": "https://github.com/choplin/webdrop#readme",
	"bugs": "https://github.com/choplin/webdrop/issues",
	"type": "module",
	"bin": {
		"webdrop": "dist/cli.js"
	},
	"files": [
		"dist",
		"template",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prebuild": "pnpm --dir ../.. run build",
		"build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
		"postbuild": "node scripts/stage-template.ts",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"ci-info": "4.4.0",
		"wrangler": "4.118.0",
		"yaml": "2.8.1"
	},
	"devDependencies": {
		"esbuild": "0.28.1"
	}
}
