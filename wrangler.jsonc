{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webdrop",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"vars": {
		// The deploy script replaces this placeholder with the user's public hostname.
		"APP_DOMAIN": "webdrop.example.test",
		"AUTHENTICATION": "google"
	},
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "SITES"
		}
	]
}
