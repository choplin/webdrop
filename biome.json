{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.agents",
			"!client/webdrop-design.html",
			"!node_modules",
			"!.wrangler",
			"!coverage",
			"!public/assets",
			"!types/generated/worker-configuration.d.ts"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
